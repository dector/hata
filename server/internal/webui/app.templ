package webui

templ AppPage(data AppPageData) {
	@WebPage("App · Hata") {
		@HouseSelector(data.HeaderHouses, data.ActiveHouseID, "/app")
		@UserBadge(data.DisplayName)
		<main>
			<div class="app-screen">
				@appPageStyles()
				@ScreenHeader("My devices", "Devices in the selected house.")
				@AppHouseGrid(data.Houses)
				@appPageScript()
			</div>
		</main>
	}
}
