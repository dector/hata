package webui

css appHousesStyle() {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
	gap: 1rem;
}

css appHouseCardStyle() {
	display: grid;
	gap: 0.75rem;
	align-content: start;
	margin-top: 0;
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css appFlushBlockStyle() {
	margin: 0;
}

css houseHeaderStyle() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
}

css houseManageLinkStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 1.75rem;
	height: 1.75rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	color: var(--muted);
	text-decoration: none;
}

css houseRoleStyle() {
	color: var(--muted);
	font-size: 0.9rem;
}

css deviceEmptyStyle() {
	color: var(--muted);
	font-style: italic;
}

css deviceListStyle() {
	display: grid;
	grid-template-columns: 1fr;
	gap: 0.5rem;
	margin: 0;
	padding-left: 0;
	list-style: none;
}

css deviceCardStyle() {
	display: grid;
	grid-template-rows: 1fr auto;
	align-items: start;
	gap: 0.85rem;
	min-height: 8rem;
	padding: 0.85rem;
	border: 1px solid var(--border);
	border-radius: 0.65rem;
}

css deviceNameStyle() {
	min-width: 0;
	display: flex;
	align-items: flex-start;
	gap: 0.65rem;
	font-weight: 700;
	line-height: 1.25;
	overflow-wrap: anywhere;
}

css deviceTitleStyle() {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.45rem;
	min-width: 0;
}

css lampIconStyle() {
	flex: 0 0 auto;
	width: 1.65rem;
	height: 1.65rem;
	margin-top: -0.1rem;
}

css deviceStateStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	align-items: center;
	border: 1px solid var(--border);
	border-radius: 999px;
	padding: 0.2rem 0.5rem;
	font-size: 0.85rem;
	font-weight: 700;
}

css deviceActionsStyle() {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex-wrap: wrap;
	gap: 0.5rem;
	margin: 0;
}

css deviceToggleFormStyle() {
	display: inline-flex;
	gap: 0;
	margin: 0;
}

css deviceToggleButtonStyle() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 0;
	border-radius: 999px;
	background: transparent;
	color: var(--muted);
	transition: color 0.12s ease, background 0.12s ease, transform 0.12s ease;
}

css deviceIconToggleButtonStyle() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 0;
	border-radius: 999px;
	background: transparent;
	color: var(--muted);
	transition: color 0.12s ease, background 0.12s ease, transform 0.12s ease;
}

css toggleIconStyle() {
	width: 1.8rem;
	height: 1.8rem;
}

css lightStateButtonsStyle() {
	display: flex;
	gap: 0.5rem;
	margin: 0.75rem 0 1rem;
}

css lightStateFormStyle() {
	flex: 1;
}

css lightStateButtonStyle() {
	width: 100%;
	padding: 0.55rem 0.75rem;
}

css lightDialogStyle() {
	max-width: min(92vw, 28rem);
	border: 1px solid var(--border);
	border-radius: 0.75rem;
	padding: 1rem;
}

css lightPresetGridStyle() {
	display: flex;
	flex-wrap: wrap;
	gap: 0.65rem;
	margin: 0.75rem 0 1rem;
}

css lightPresetOptionStyle() {
	display: inline-flex;
	cursor: pointer;
}

css lightPresetInputStyle() {
	position: absolute;
	width: 1px;
	height: 1px;
	margin: -1px;
	overflow: hidden;
	clip: rect(0, 0, 0, 0);
}

css lightSwatchStyle() {
	display: inline-block;
	width: 2.6rem;
	height: 2.6rem;
	border: 2px solid var(--border);
	border-radius: 999px;
	box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.85);
	transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
}

templ lampIcon(statusClass string) {
	<svg class={ "lamp-icon", lampIconStyle(), statusClass } xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M176,232a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,232Zm40-128a87.55,87.55,0,0,1-33.64,69.21A16.24,16.24,0,0,0,176,186v6a16,16,0,0,1-16,16H96a16,16,0,0,1-16-16v-6a16,16,0,0,0-6.23-12.66A87.59,87.59,0,0,1,40,104.49C39.74,56.83,78.26,17.14,125.88,16A88,88,0,0,1,216,104Zm-16,0a72,72,0,0,0-73.74-72c-39,.92-70.47,33.39-70.26,72.39a71.65,71.65,0,0,0,27.64,56.3A32,32,0,0,1,96,186v6h64v-6a32.15,32.15,0,0,1,12.47-25.35A71.65,71.65,0,0,0,200,104Zm-16.11-9.34a57.6,57.6,0,0,0-46.56-46.55,8,8,0,0,0-2.66,15.78c16.57,2.79,30.63,16.85,33.44,33.45A8,8,0,0,0,176,104a9,9,0,0,0,1.35-.11A8,8,0,0,0,183.89,94.66Z"></path></svg>
}

templ toggleIcon() {
	<svg class={ "toggle-icon-on", toggleIconStyle() } xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M176,56H80a72,72,0,0,0,0,144h96a72,72,0,0,0,0-144Zm0,128H80A56,56,0,0,1,80,72h96a56,56,0,0,1,0,112Zm0-96a40,40,0,1,0,40,40A40,40,0,0,0,176,88Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,176,152Z"></path></svg>
	<svg class={ "toggle-icon-off", toggleIconStyle() } xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M176,56H80a72,72,0,0,0,0,144h96a72,72,0,0,0,0-144Zm0,128H80A56,56,0,0,1,80,72h96a56,56,0,0,1,0,112ZM80,88a40,40,0,1,0,40,40A40,40,0,0,0,80,88Zm0,64a24,24,0,1,1,24-24A24,24,0,0,1,80,152Z"></path></svg>
}

templ controlsIcon() {
	<svg class={ toggleIconStyle() } xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M136,120v96a8,8,0,0,1-16,0V120a8,8,0,0,1,16,0Zm64,72a8,8,0,0,0-8,8v16a8,8,0,0,0,16,0V200A8,8,0,0,0,200,192Zm24-32H208V40a8,8,0,0,0-16,0V160H176a8,8,0,0,0,0,16h48a8,8,0,0,0,0-16ZM56,160a8,8,0,0,0-8,8v48a8,8,0,0,0,16,0V168A8,8,0,0,0,56,160Zm24-32H64V40a8,8,0,0,0-16,0v88H32a8,8,0,0,0,0,16H80a8,8,0,0,0,0-16Zm72-48H136V40a8,8,0,0,0-16,0V80H104a8,8,0,0,0,0,16h48a8,8,0,0,0,0-16Z"></path></svg>
}

templ AppDeviceCard(device AppDeviceData) {
	<li id={ deviceCardID(device) } class={ "device-card", deviceCardStyle() } data-availability={ device.Availability } data-state={ device.State } data-toggle-error={ device.ToggleError }>
		<span class={ deviceNameStyle() }>
			if device.IsLight {
				@lampIcon(deviceStatusClass(device))
			}
			<span class={ deviceTitleStyle() }>
				<span>{ device.Name }</span>
				<span class={ "device-status-badge", deviceStateStyle(), deviceStatusClass(device) }>{ deviceStatusLabel(device) }</span>
			</span>
		</span>
		if device.Availability != "offline" {
			<span class={ deviceActionsStyle() }>
				if device.IsLight {
					<button class={ "device-controls-button", deviceToggleButtonStyle() } type="button" data-light-open={ lightDialogID(device) } aria-label={ "Open controls for " + device.Name } title="Controls">
						@controlsIcon()
					</button>
				}
				<form
					class={ deviceToggleFormStyle() }
					method="post"
					action={ templ.SafeURL(device.ToggleURL) }
					data-on-submit__prevent={ datastarPostFormAction(device.ToggleURL, "#" + deviceCardID(device)) }
					data-device-toggle-form
					data-next-state={ toggleNextState(device) }
				>
					<button class={ "device-toggle-button", deviceIconToggleButtonStyle(), deviceStatusClass(device) } type="submit" aria-label={ "Toggle " + device.Name } title="Toggle">
						@toggleIcon()
					</button>
				</form>
			</span>
		}
	</li>
}

templ AppPage(data AppPageData) {
	@PageLayout("App · Hata", data.DisplayName) {
		<div class="app-screen">
			<style>
				@media (min-width: 48rem) {
					.app-screen .device-list {
						grid-template-columns: repeat(2, minmax(0, 1fr));
					}
				}
				@media (min-width: 76rem) {
					.app-screen .device-list {
						grid-template-columns: repeat(3, minmax(0, 1fr));
					}
				}
				.device-card {
					background: rgba(29, 32, 33, 0.35);
					transition: border-color 0.12s ease, background 0.12s ease;
				}
				.device-card:hover {
					border-color: var(--accent);
					background: rgba(29, 32, 33, 0.55);
				}
				.device-card[data-availability="offline"] {
					opacity: 0.72;
				}
				.device-card[data-availability="offline"]:hover {
					border-color: rgba(251, 73, 52, 0.75);
				}
				.device-status-on {
					color: #fabd2f;
					border-color: rgba(250, 189, 47, 0.75);
					background: rgba(250, 189, 47, 0.14);
				}
				.device-status-off {
					color: var(--muted);
					border-color: var(--border);
					background: rgba(168, 153, 132, 0.10);
				}
				.device-status-offline {
					color: #fb4934;
					border-color: rgba(251, 73, 52, 0.75);
					background: rgba(251, 73, 52, 0.12);
				}
				.device-status-unknown {
					color: var(--muted);
				}
				.device-status-badge {
					letter-spacing: 0.01em;
				}
				button.device-toggle-button:hover,
				button.device-controls-button:hover {
					background: rgba(142, 192, 124, 0.16);
					color: var(--accent-hover);
					transform: scale(1.08);
				}
				.device-toggle-button.device-status-on {
					color: #fabd2f;
				}
				.device-toggle-button.device-status-off {
					color: var(--muted);
				}
				.device-card[data-state="on"] .toggle-icon-off,
				.device-card:not([data-state="on"]) .toggle-icon-on {
					display: none;
				}
				.device-card[data-device-pending="true"] {
					opacity: 0.82;
				}
				.lamp-icon.device-status-on {
					filter: drop-shadow(0 0 0.35rem rgba(250, 189, 47, 0.7));
				}
				.light-preset input:checked + .light-swatch {
					border-color: var(--text);
					box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.9), 0 0 0 3px var(--accent);
					transform: scale(1.08);
				}
				.light-preset:focus-within .light-swatch {
					outline: 2px solid var(--accent);
					outline-offset: 3px;
				}
				dialog::backdrop {
					background: rgba(0, 0, 0, 0.78);
				}
			</style>
			@ScreenHeader("My devices", "Devices grouped by houses.")
			if len(data.Houses) == 0 {
				<p>You don't have access to any houses yet.</p>
			} else {
				<div class={ appHousesStyle() }>
					for _, house := range data.Houses {
						<section class={ appHouseCardStyle() }>
							<div class={ houseHeaderStyle() }>
								<h2 class={ appFlushBlockStyle() }>{ house.DisplayName }</h2>
								<a class={ houseManageLinkStyle() } href={ templ.SafeURL(houseManagePath(house.ID)) } aria-label={ "Manage " + house.DisplayName } title="Manage house">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"/><path d="M19.43 12.98c.04-.32.07-.65.07-.98s-.02-.66-.07-.98l2.11-1.65a.5.5 0 0 0 .12-.64l-2-3.46a.5.5 0 0 0-.6-.22l-2.49 1a7.28 7.28 0 0 0-1.69-.98L14.5 2.42A.5.5 0 0 0 14 2h-4a.5.5 0 0 0-.5.42L9.12 5.07c-.61.24-1.18.56-1.69.98l-2.49-1a.5.5 0 0 0-.6.22l-2 3.46a.5.5 0 0 0 .12.64l2.11 1.65c-.04.32-.07.65-.07.98s.02.66.07.98l-2.11 1.65a.5.5 0 0 0-.12.64l2 3.46a.5.5 0 0 0 .6.22l2.49-1c.51.4 1.08.73 1.69.98l.38 2.65a.5.5 0 0 0 .5.42h4a.5.5 0 0 0 .5-.42l.38-2.65c.61-.24 1.18-.56 1.69-.98l2.49 1a.5.5 0 0 0 .6-.22l2-3.46a.5.5 0 0 0-.12-.64l-2.11-1.65Z"/></svg>
								</a>
							</div>
							<p class={ appFlushBlockStyle(), houseRoleStyle() }>House ID: { house.ID } · Role: { house.Role }</p>
							if len(house.Devices) == 0 {
								<p class={ appFlushBlockStyle(), deviceEmptyStyle() }>No devices in this house.</p>
							} else {
								<ul class={ "device-list", deviceListStyle() }>
									for _, device := range house.Devices {
										@AppDeviceCard(device)
										if device.IsLight && device.Availability == "online" {
											<dialog id={ lightDialogID(device) } class={ lightDialogStyle() }>
												<h3>{ device.Name }</h3>
												<p>State: <span data-light-state-label>{ device.State }</span> · Availability: { device.Availability }</p>
												<div class={ lightStateButtonsStyle() }>
													<form data-light-state-form class={ lightStateFormStyle() } method="post" action={ templ.SafeURL(device.StateURL) }>
														<input type="hidden" name="state" value="on"/>
														<button class={ lightStateButtonStyle() } type="submit">On</button>
													</form>
													<form data-light-state-form class={ lightStateFormStyle() } method="post" action={ templ.SafeURL(device.StateURL) }>
														<input type="hidden" name="state" value="off"/>
														<button class={ lightStateButtonStyle() } type="submit">Off</button>
													</form>
												</div>
												<form method="post" action={ templ.SafeURL(device.LightURL) }>
													<div class={ lightPresetGridStyle() }>
														for _, preset := range device.LightPresets {
															<label class={ "light-preset", lightPresetOptionStyle() } title={ preset.Label } aria-label={ preset.Label }>
																<input data-color-preset-input class={ lightPresetInputStyle() } type="radio" name="colorPreset" value={ preset.ID } checked?={ lightPresetChecked(device, preset.ID) }/>
																<span class={ "light-swatch", lightSwatchStyle() } style={ "background-color: " + preset.Hex }></span>
															</label>
														}
													</div>
													<label>Brightness <strong data-brightness-label>{ lightBrightnessValue(device) }%</strong></label>
													<input data-brightness-slider type="range" name="brightness" min="0" max="100" step="5" value={ lightBrightnessValue(device) }/>
												</form>
											</dialog>
										}
									}
								</ul>
							}
						</section>
					}
				</div>
			}
			<script>
				const deviceStatusClasses = ['device-status-on', 'device-status-off', 'device-status-offline', 'device-status-unknown'];
				function applyDeviceStatusClass(element, statusClass) {
					if (!element) return;
					element.classList.remove(...deviceStatusClasses);
					element.classList.add(statusClass);
				}
				function applyOptimisticToggle(form) {
					const nextState = form.getAttribute('data-next-state');
					const card = form.closest('.device-card');
					if (!card || (nextState !== 'on' && nextState !== 'off')) return;
					const statusClass = nextState === 'on' ? 'device-status-on' : 'device-status-off';
					card.dataset.state = nextState;
					card.dataset.devicePending = 'true';
					applyDeviceStatusClass(card.querySelector('.device-status-badge'), statusClass);
					applyDeviceStatusClass(card.querySelector('.device-toggle-button'), statusClass);
					applyDeviceStatusClass(card.querySelector('.lamp-icon'), statusClass);
					const badge = card.querySelector('.device-status-badge');
					if (badge) badge.textContent = nextState;
					const button = form.querySelector('button[type="submit"]');
					if (button) button.disabled = true;
				}
				function reportDeviceToggleError(card) {
					const message = card?.dataset?.toggleError;
					if (!message) return;
					delete card.dataset.toggleError;
					window.alert(message);
				}
				document.addEventListener('submit', (event) => {
					const form = event.target.closest('[data-device-toggle-form]');
					if (!form) return;
					applyOptimisticToggle(form);
				});
				new MutationObserver((mutations) => {
					for (const mutation of mutations) {
						for (const node of mutation.addedNodes) {
							if (!(node instanceof HTMLElement)) continue;
							if (node.matches('.device-card')) reportDeviceToggleError(node);
							node.querySelectorAll?.('.device-card').forEach(reportDeviceToggleError);
						}
					}
				}).observe(document.body, { childList: true, subtree: true });
				document.addEventListener('click', (event) => {
					const openButton = event.target.closest('[data-light-open]');
					if (openButton) {
						event.preventDefault();
						const dialog = document.getElementById(openButton.getAttribute('data-light-open'));
						if (dialog) dialog.showModal();
						return;
					}
					if (event.target instanceof HTMLDialogElement && event.target.open) {
						const rect = event.target.getBoundingClientRect();
						const isOutside = event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom;
						if (isOutside) event.target.close();
					}
				});
				document.addEventListener('submit', async (event) => {
					const form = event.target.closest('[data-light-state-form]');
					if (!form) return;
					event.preventDefault();
					const button = event.submitter;
					if (button) button.disabled = true;
					try {
						const response = await fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' });
						if (!response.ok) throw new Error('state request failed');
						const state = new FormData(form).get('state');
						const dialog = form.closest('dialog');
						const label = dialog?.querySelector('[data-light-state-label]');
						if (label) label.textContent = state;
					} catch (error) {
						window.alert('Failed to update light state.');
					} finally {
						if (button) button.disabled = false;
					}
				});
				document.addEventListener('input', (event) => {
					if (!event.target.matches('[data-brightness-slider]')) return;
					const label = event.target.form?.querySelector('[data-brightness-label]');
					if (label) label.textContent = event.target.value + '%';
				});
				document.addEventListener('change', async (event) => {
					let fieldName = '';
					let fieldValue = '';
					if (event.target.matches('[data-brightness-slider]')) {
						fieldName = 'brightness';
						fieldValue = event.target.value;
					} else if (event.target.matches('[data-color-preset-input]')) {
						fieldName = 'colorPreset';
						fieldValue = event.target.value;
					} else {
						return;
					}
					const form = event.target.form;
					if (!form) return;
					const data = new FormData();
					data.set(fieldName, fieldValue);
					try {
						const response = await fetch(form.action, { method: 'POST', body: data, credentials: 'same-origin' });
						if (!response.ok) throw new Error('light request failed');
					} catch (error) {
						window.alert('Failed to update light setting.');
					}
				});
			</script>
		</div>
	}
}
