package webui

css appHousesStyle() {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
	gap: 1rem;
}

css appHouseCardStyle() {
	display: grid;
	gap: 0.75rem;
	align-content: start;
	margin-top: 0;
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css appFlushBlockStyle() {
	margin: 0;
}

css houseHeaderStyle() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
}

css houseManageLinkStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 1.75rem;
	height: 1.75rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	color: var(--muted);
	text-decoration: none;
}

css houseRoleStyle() {
	color: var(--muted);
	font-size: 0.9rem;
}

css deviceEmptyStyle() {
	color: var(--muted);
	font-style: italic;
}

css deviceListStyle() {
	display: grid;
	gap: 0.5rem;
	margin: 0;
	padding-left: 0;
	list-style: none;
}

css deviceCardStyle() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
	padding: 0.65rem 0.75rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css deviceNameStyle() {
	min-width: 0;
	overflow-wrap: anywhere;
}

css deviceStateStyle() {
	flex: 0 0 auto;
	color: var(--muted);
}

css deviceActionsStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
}

css deviceToggleFormStyle() {
	display: inline-flex;
	gap: 0;
}

css deviceToggleButtonStyle() {
	padding: 0.35rem 0.6rem;
	font-size: 0.85rem;
}

templ AppPage(data AppPageData) {
	@PageLayout("App · Hata", data.HTMXScriptSrc, data.DisplayName) {
		<div class="app-screen">
			@ScreenHeader("My devices", "Devices grouped by houses.")
			if len(data.Houses) == 0 {
				<p>You don't have access to any houses yet.</p>
			} else {
				<div class={ appHousesStyle() }>
					for _, house := range data.Houses {
						<section class={ appHouseCardStyle() }>
							<div class={ houseHeaderStyle() }>
								<h2 class={ appFlushBlockStyle() }>{ house.DisplayName }</h2>
								<a class={ houseManageLinkStyle() } href={ templ.SafeURL(houseManagePath(house.ID)) } aria-label={ "Manage " + house.DisplayName } title="Manage house">
									<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15.5A3.5 3.5 0 1 0 12 8a3.5 3.5 0 0 0 0 7.5Z"/><path d="M19.43 12.98c.04-.32.07-.65.07-.98s-.02-.66-.07-.98l2.11-1.65a.5.5 0 0 0 .12-.64l-2-3.46a.5.5 0 0 0-.6-.22l-2.49 1a7.28 7.28 0 0 0-1.69-.98L14.5 2.42A.5.5 0 0 0 14 2h-4a.5.5 0 0 0-.5.42L9.12 5.07c-.61.24-1.18.56-1.69.98l-2.49-1a.5.5 0 0 0-.6.22l-2 3.46a.5.5 0 0 0 .12.64l2.11 1.65c-.04.32-.07.65-.07.98s.02.66.07.98l-2.11 1.65a.5.5 0 0 0-.12.64l2 3.46a.5.5 0 0 0 .6.22l2.49-1c.51.4 1.08.73 1.69.98l.38 2.65a.5.5 0 0 0 .5.42h4a.5.5 0 0 0 .5-.42l.38-2.65c.61-.24 1.18-.56 1.69-.98l2.49 1a.5.5 0 0 0 .6-.22l2-3.46a.5.5 0 0 0-.12-.64l-2.11-1.65Z"/></svg>
								</a>
							</div>
							<p class={ appFlushBlockStyle(), houseRoleStyle() }>House ID: { house.ID } · Role: { house.Role }</p>
							if len(house.Devices) == 0 {
								<p class={ appFlushBlockStyle(), deviceEmptyStyle() }>No devices in this house.</p>
							} else {
								<ul class={ deviceListStyle() }>
									for _, device := range house.Devices {
										<li class={ "device-card", deviceCardStyle() }>
											<span class={ deviceNameStyle() }>{ device.Name } ({ device.ID })</span>
											<span class={ deviceActionsStyle() }>
												if device.Availability == "offline" {
													<span class={ deviceStateStyle() }>· offline</span>
												} else {
													<span class={ deviceStateStyle() }>· { device.State }</span>
													<form class={ deviceToggleFormStyle() } method="post" action={ templ.SafeURL(device.ToggleURL) }>
														<button class={ deviceToggleButtonStyle() } type="submit">Toggle</button>
													</form>
												}
											</span>
										</li>
									}
								</ul>
							}
						</section>
					}
				</div>
			}
		</div>
	}
}
