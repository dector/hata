templ weatherConditionIcon(icon string) {
	<svg class={ weatherIconStyle() } xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d={ weatherIconPath(icon) }></path></svg>
}

