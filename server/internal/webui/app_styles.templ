package webui

css appHousesStyle() {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
	gap: 1rem;
}

css appHouseCardStyle() {
	display: grid;
	gap: 0.75rem;
	align-content: start;
	margin-top: 0;
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css appFlushBlockStyle() {
	margin: 0;
}

css houseHeaderStyle() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
}

css houseManageLinkStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 1.75rem;
	height: 1.75rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	color: var(--muted);
	text-decoration: none;
}

css houseRoleStyle() {
	color: var(--muted);
	font-size: 0.9rem;
}

css deviceEmptyStyle() {
	color: var(--muted);
	font-style: italic;
}

css deviceListStyle() {
	display: grid;
	grid-template-columns: 1fr;
	gap: 0.5rem;
	margin: 0;
	padding-left: 0;
	list-style: none;
}

css deviceCardStyle() {
	display: grid;
	grid-template-rows: 1fr auto;
	align-items: start;
	gap: 0.85rem;
	min-height: 8rem;
	padding: 0.85rem;
	border: 1px solid var(--border);
	border-radius: 0.65rem;
}

css deviceNameStyle() {
	min-width: 0;
	display: flex;
	align-items: flex-start;
	gap: 0.65rem;
	font-weight: 700;
	line-height: 1.25;
	overflow-wrap: anywhere;
}

css deviceTitleStyle() {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.45rem;
	min-width: 0;
}

css lampIconStyle() {
	flex: 0 0 auto;
	width: 1.65rem;
	height: 1.65rem;
	margin-top: -0.1rem;
}

css deviceStateStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	align-items: center;
	border: 1px solid var(--border);
	border-radius: 999px;
	padding: 0.2rem 0.5rem;
	font-size: 0.85rem;
	font-weight: 700;
}

css deviceActionsStyle() {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex-wrap: wrap;
	gap: 0.5rem;
	margin: 0;
}

css deviceToggleFormStyle() {
	display: inline-flex;
	gap: 0;
	margin: 0;
}

css deviceToggleButtonStyle() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 0;
	border-radius: 999px;
	background: transparent;
	color: var(--muted);
	transition: color 0.12s ease, background 0.12s ease, transform 0.12s ease;
}

css deviceIconToggleButtonStyle() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 0;
	border-radius: 999px;
	background: transparent;
	color: var(--muted);
	transition: color 0.12s ease, background 0.12s ease, transform 0.12s ease;
}

css toggleIconStyle() {
	width: 1.8rem;
	height: 1.8rem;
}

css lightStateButtonsStyle() {
	display: flex;
	gap: 0.5rem;
	margin: 0.75rem 0 1rem;
}

css lightStateFormStyle() {
	flex: 1;
}

css lightStateButtonStyle() {
	width: 100%;
	padding: 0.55rem 0.75rem;
}

css lightDialogStyle() {
	max-width: min(92vw, 28rem);
	border: 1px solid var(--border);
	border-radius: 0.75rem;
	padding: 1rem;
}

css lightPresetGridStyle() {
	display: flex;
	flex-wrap: wrap;
	gap: 0.65rem;
	margin: 0.75rem 0 1rem;
}

css lightPresetOptionStyle() {
	display: inline-flex;
	cursor: pointer;
}

css lightPresetInputStyle() {
	position: absolute;
	width: 1px;
	height: 1px;
	margin: -1px;
	overflow: hidden;
	clip: rect(0, 0, 0, 0);
}

css lightSwatchStyle() {
	display: inline-block;
	width: 2.6rem;
	height: 2.6rem;
	border: 2px solid var(--border);
	border-radius: 999px;
	box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.85);
	transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease;
}

templ appPageStyles() {
	<style>
		@media (min-width: 48rem) {
			.app-screen .device-list {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
		@media (min-width: 76rem) {
			.app-screen .device-list {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}
		}
		.device-card {
			background: rgba(29, 32, 33, 0.35);
			transition: opacity 0.22s ease;
		}
		.device-card:hover,
		.device-card.device-card-hovered {
			border-color: var(--accent);
			background: rgba(29, 32, 33, 0.55);
		}
		.device-card[data-availability="offline"] {
			opacity: 0.72;
		}
		.device-card[data-availability="offline"]:hover {
			border-color: rgba(251, 73, 52, 0.75);
		}
		.device-status-on {
			color: #fabd2f;
			border-color: rgba(250, 189, 47, 0.75);
			background: rgba(250, 189, 47, 0.14);
		}
		.device-status-off {
			color: var(--muted);
			border-color: var(--border);
			background: rgba(168, 153, 132, 0.10);
		}
		.device-status-offline {
			color: #fb4934;
			border-color: rgba(251, 73, 52, 0.75);
			background: rgba(251, 73, 52, 0.12);
		}
		.device-status-unknown {
			color: var(--muted);
		}
		.device-status-badge {
			letter-spacing: 0.01em;
		}
		button.device-toggle-button:hover,
		button.device-controls-button:hover {
			background: rgba(142, 192, 124, 0.16);
			color: var(--accent-hover);
			transform: scale(1.08);
		}
		.device-toggle-button.device-status-on {
			color: #fabd2f;
		}
		.device-toggle-button.device-status-off {
			color: var(--muted);
		}
		.device-card[data-state="on"] .toggle-icon-off,
		.device-card:not([data-state="on"]) .toggle-icon-on {
			display: none;
		}
		.lamp-icon.device-status-on {
			filter: drop-shadow(0 0 0.35rem rgba(250, 189, 47, 0.7));
		}
		.light-preset input:checked + .light-swatch {
			border-color: var(--text);
			box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.9), 0 0 0 3px var(--accent);
			transform: scale(1.08);
		}
		.light-preset:focus-within .light-swatch {
			outline: 2px solid var(--accent);
			outline-offset: 3px;
		}
		dialog::backdrop {
			background: rgba(0, 0, 0, 0.78);
		}
	</style>
}
