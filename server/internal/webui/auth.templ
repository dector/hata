package webui

templ LoginPage(data LoginPageData) {
	@WebPage("Sign in · Hata") {
		<main>
			<h1>Sign in</h1>
			<p>Use your credentials to start a browser session.</p>
			<div id="login-shell">
				<form id="login-form" method="post" action="/auth/login" data-on-submit__prevent="@post('/auth/login', {contentType: 'form', selector: '#login-shell'})">
					<label for="username">Username</label>
					<input id="username" name="username" type="text" autocomplete="username" required/>

					<label for="password">Password</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required/>

					<input type="hidden" name="then" value={ data.Then }/>
					<button type="submit">Sign in</button>
				</form>
				if data.Error != "" {
					<p role="alert">{ data.Error }</p>
				}
			</div>
		</main>
	}
}

templ LogoutPage(data LogoutPageData) {
	@WebPage("Sign out · Hata") {
		<main id="logout-shell">
			<h1>Sign out</h1>
			<p>This clears your auth cookie for this browser.</p>
			<form method="post" action="/auth/logout" data-on-submit__prevent="@post('/auth/logout', {contentType: 'form'})">
				<button type="submit">Sign out</button>
			</form>
		</main>
	}
}
