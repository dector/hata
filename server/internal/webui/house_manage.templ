package webui

css houseManageHeroStyle() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	margin: 0 0 1rem;
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: 0.75rem;
	background: rgba(250, 189, 47, 0.06);
}

css houseManageRoleBadgeStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	align-items: center;
	border: 1px solid var(--border);
	border-radius: 999px;
	padding: 0.25rem 0.65rem;
	color: var(--muted);
	font-size: 0.85rem;
	font-weight: 700;
}

css houseManageHeroTextStyle() {
	display: grid;
	gap: 0.25rem;
}

css houseManageSectionStyle() {
	display: grid;
	gap: 0.75rem;
	margin-top: 1rem;
	padding-top: 1rem;
	border-top: 1px solid var(--border);
}

css houseManageSectionHeaderStyle() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
}

css houseManageAddPanelStyle() {
	display: grid;
	gap: 0.75rem;
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css houseManageInlineFormStyle() {
	display: flex;
	flex-wrap: wrap;
	align-items: end;
	gap: 0.75rem;
}

css houseManageNetworkListStyle() {
	display: grid;
	gap: 0.5rem;
	margin: 0;
	padding-left: 0;
	list-style: none;
}

css houseManageNetworkItemStyle() {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: 0.5rem;
	padding: 0.75rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css discoveryResultsStyle() {
	display: grid;
	gap: 0.5rem;
	margin: 0;
	padding-left: 0;
	list-style: none;
}

css houseManageDeviceCardStyle() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
	min-height: 0;
	padding: 0.9rem;
	border: 1px solid var(--border);
	border-radius: 0.75rem;
	background: rgba(255, 255, 255, 0.02);
}

css houseManageDeviceInfoStyle() {
	display: grid;
	gap: 0.35rem;
	min-width: 0;
}

css houseManageDeviceMetaStyle() {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.4rem;
	color: var(--muted);
	font-size: 0.9rem;
}

css houseManageDeviceBadgeStyle() {
	display: inline-flex;
	align-items: center;
	border: 1px solid var(--border);
	border-radius: 999px;
	padding: 0.15rem 0.5rem;
	font-size: 0.8rem;
	font-weight: 700;
	text-transform: uppercase;
}

css houseManageDeviceActionsStyle() {
	flex: 0 0 auto;
	display: inline-flex;
	gap: 0.4rem;
	align-items: center;
}

css houseManageIconFormStyle() {
	display: inline-flex;
	gap: 0;
	margin: 0;
}

css houseManageIconButtonStyle() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 1px solid var(--border);
	border-radius: 999px;
	background: transparent;
	color: var(--muted);
}

css houseManageDangerButtonStyle() {
	color: #fb4934;
}

css discoveryStatusStyle() {
	color: var(--muted);
}

templ HouseManagePage(data HouseManagePageData) {
	@WebPage("House Settings · Hata") {
		@HouseSelector(data.HeaderHouses, data.ActiveHouseID, "/app")
		@UserBadge(data.DisplayName)
		<main>
		<div class="app-screen">
			@ScreenHeader("House Settings", "Manage devices and discovery networks.")
			<div class={ houseManageHeroStyle() }>
				<div class={ houseManageHeroTextStyle() }>
					<strong>House Settings</strong>
					<span class={ discoveryStatusStyle() }>Manage devices and discovery networks.</span>
				</div>
				<span class={ houseManageRoleBadgeStyle() }>{ data.House.Role }</span>
			</div>

			<section class={ houseManageSectionStyle() } data-discover-url={ houseManageDiscoverPath(data.House.ID) }>
				<div class={ houseManageSectionHeaderStyle() }>
					<h2 class={ appFlushBlockStyle() }>{ houseDevicesTitle(data.House) }</h2>
					<button id="device-add-button" type="button">+ Add</button>
				</div>

				if len(data.House.Devices) == 0 {
					<p class={ appFlushBlockStyle(), deviceEmptyStyle() }>No devices in this house.</p>
				} else {
					<ul class={ deviceListStyle() }>
						for _, device := range data.House.Devices {
							<li class={ houseManageDeviceCardStyle() }>
								<div class={ houseManageDeviceInfoStyle() }>
									<a class={ deviceNameStyle() } href={ templ.SafeURL(device.DetailsURL) }>{ device.Name }</a>
									<span class={ houseManageDeviceMetaStyle() }>
										<span class={ houseManageDeviceBadgeStyle() }>{ device.IntegrationID }</span>
										if device.IntegrationIP != "" {
											<span>IP { device.IntegrationIP }</span>
										}
										if device.Availability != "" {
											<span>{ device.Availability }</span>
										}
									</span>
								</div>
								<div class={ houseManageDeviceActionsStyle() }>
									<a class={ houseManageIconButtonStyle() } href={ templ.SafeURL(device.DetailsURL) } aria-label={ "Open info for " + device.Name } title="Info">@infoIcon()</a>
									if data.CanManageHouse {
										<form class={ "device-rename-form", houseManageIconFormStyle() } method="post" action={ houseDeviceRenamePath(data.House.ID, device.ID) } data-current-name={ device.Name }>
											<input type="hidden" name="name"/>
											<button class={ houseManageIconButtonStyle() } type="submit" aria-label={ "Rename " + device.Name } title="Rename">@editIcon()</button>
										</form>
										<form class={ "device-delete-form", houseManageIconFormStyle() } method="post" action={ houseDeviceDeletePath(data.House.ID, device.ID) } data-current-name={ device.Name }>
											<button class={ houseManageIconButtonStyle(), houseManageDangerButtonStyle() } type="submit" aria-label={ "Remove " + device.Name } title="Remove">@deleteIcon()</button>
										</form>
									}
								</div>
							</li>
						}
					</ul>
				}

				<div id="device-add-panel" class={ houseManageAddPanelStyle() } hidden>
					<p class={ appFlushBlockStyle(), discoveryStatusStyle() }>Scan supported integrations for devices.</p>
					<p class={ appFlushBlockStyle() }>This scan will check the discovery networks listed below.</p>
					<button id="device-scan-button" type="button">Scan</button>
					<p id="device-discovery-status" class={ appFlushBlockStyle(), discoveryStatusStyle() }></p>
					<ul id="device-discovery-results" class={ discoveryResultsStyle() }></ul>
				</div>
			</section>

			<section class={ houseManageSectionStyle() }>
				<div class={ houseManageSectionHeaderStyle() }>
					<h2 class={ appFlushBlockStyle() }>Discovery networks</h2>
				</div>
				<p class={ appFlushBlockStyle(), discoveryStatusStyle() }>Extra network ranges to scan. Example: 192.168.1.0/24 scans 192.168.1.*.</p>
				<ul class={ houseManageNetworkListStyle() }>
					if len(data.DefaultDiscoveryNetworks) == 0 {
						<li class={ houseManageNetworkItemStyle() }>
							<span><strong>Default</strong> · server local networks</span>
							<span class={ discoveryStatusStyle() }>Built in</span>
						</li>
					} else {
						for _, cidr := range data.DefaultDiscoveryNetworks {
							<li class={ houseManageNetworkItemStyle() }>
								<span><strong>Default</strong> · { cidr }</span>
								<span class={ discoveryStatusStyle() }>Built in</span>
							</li>
						}
					}
					if len(data.DiscoveryNetworks) == 0 {
						<li class={ houseManageNetworkItemStyle() }>
							<span class={ deviceEmptyStyle() }>No extra discovery networks configured.</span>
						</li>
					} else {
						for _, network := range data.DiscoveryNetworks {
							<li class={ houseManageNetworkItemStyle() }>
								<span>
									if network.Label != "" {
										<strong>{ network.Label }</strong> · { network.CIDR }
									} else {
										{ network.CIDR }
									}
								</span>
								if data.CanManageHouse {
									<form method="post" action={ houseDiscoveryNetworkDeletePath(data.House.ID, network.ID) }>
										<button type="submit">Remove</button>
									</form>
								}
							</li>
						}
					}
				</ul>
				if data.CanManageHouse {
					<form class={ houseManageInlineFormStyle() } method="post" action={ houseDiscoveryNetworksPath(data.House.ID) }>
						<label for="discovery-network-cidr">CIDR
							<input id="discovery-network-cidr" name="cidr" type="text" placeholder="192.168.1.0/24" required/>
						</label>
						<label for="discovery-network-label">Label
							<input id="discovery-network-label" name="label" type="text" placeholder="Main WiFi"/>
						</label>
						<button type="submit">Add</button>
					</form>
				} else {
					<p class={ appFlushBlockStyle(), discoveryStatusStyle() }>Only house admins can change discovery networks.</p>
				}
			</section>

			<p><a href="/app">← Back to app</a></p>
			<script>
				(() => {
					const addButton = document.getElementById('device-add-button');
					const panel = document.getElementById('device-add-panel');
					const scanButton = document.getElementById('device-scan-button');
					const status = document.getElementById('device-discovery-status');
					const results = document.getElementById('device-discovery-results');
					const section = document.querySelector('[data-discover-url]');
					let source;
					let completed = false;

					addButton?.addEventListener('click', () => {
						panel.hidden = !panel.hidden;
					});

					document.querySelectorAll('.device-rename-form').forEach((form) => {
						form.addEventListener('submit', (event) => {
							const currentName = form.dataset.currentName || '';
							const name = prompt('New device name:', currentName);
							if (name === null) {
								event.preventDefault();
								return;
							}
							const trimmed = name.trim();
							if (!trimmed) {
								event.preventDefault();
								return;
							}
							form.querySelector('input[name="name"]').value = trimmed;
						});
					});

					document.querySelectorAll('.device-delete-form').forEach((form) => {
						form.addEventListener('submit', (event) => {
							const currentName = form.dataset.currentName || 'this device';
							if (!confirm(`Remove ${currentName}?`)) {
								event.preventDefault();
							}
						});
					});

					function deviceDiscoveryForm(action, buttonLabel, fields) {
						const form = document.createElement('form');
						form.method = 'post';
						form.action = action;
						form.style.display = 'inline';
						form.style.marginLeft = '0.5rem';

						for (const [name, value] of Object.entries(fields)) {
							const input = document.createElement('input');
							input.type = 'hidden';
							input.name = name;
							input.value = value;
							form.append(input);
						}

						const button = document.createElement('button');
						button.type = 'submit';
						button.textContent = buttonLabel;
						form.append(button);
						return form;
					}

					scanButton?.addEventListener('click', () => {
						if (source) {
							source.close();
						}
						results.replaceChildren();
						status.textContent = 'Starting discovery…';
						scanButton.disabled = true;
						completed = false;
						source = new EventSource(section.dataset.discoverUrl);

						source.addEventListener('open', () => {
							status.textContent = 'Discovery connection open.';
						});

						source.addEventListener('progress', (event) => {
							status.textContent = event.data;
						});

						source.addEventListener('device', (event) => {
							const device = JSON.parse(event.data);
							const item = document.createElement('li');
							const label = document.createElement('span');
							label.textContent = `[${device.integration}] ${device.name || 'Unnamed device'} at ${device.ip}`;
							item.append(label);

							if (device.ipChanged && device.updateUrl) {
								const existing = document.createElement('span');
								existing.textContent = ` · matches ${device.existingDeviceName || device.existingDeviceId}; IP changed ${device.existingIp} → ${device.ip}`;
								item.append(existing);
								item.append(deviceDiscoveryForm(device.updateUrl, 'Update', {integration: device.integration, ip: device.ip, mac: device.mac || '', state: device.state || ''}));
							} else if (device.inHouse) {
								const existing = document.createElement('span');
								existing.textContent = ' · already in this house';
								item.append(existing);
							} else if (device.addUrl) {
								item.append(deviceDiscoveryForm(device.addUrl, 'Add', {integration: device.integration, name: device.name || '', ip: device.ip, mac: device.mac || '', state: device.state || ''}));
							}

							results.append(item);
						});

						source.addEventListener('done', (event) => {
							completed = true;
							status.textContent = event.data || 'Discovery complete.';
							scanButton.disabled = false;
							source.close();
						});

						source.onerror = () => {
							if (!completed) {
								status.textContent = 'Discovery connection failed.';
							}
							scanButton.disabled = false;
							source?.close();
						};
					});
				})();
			</script>
		</div>
		</main>
	}
}
