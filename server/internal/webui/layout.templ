package webui

css houseSelectorStyle() {
	position: fixed;
	top: 1rem;
	left: 1rem;
	z-index: 10;
	max-width: calc(100vw - 2rem);
}

css houseSelectorSummaryStyle() {
	display: inline-flex;
	align-items: center;
	gap: 0.35rem;
	max-width: min(22rem, calc(100vw - 2rem));
	padding: 0.4rem 0.55rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	background: var(--surface);
	color: var(--text);
	font-size: 0.85rem;
	cursor: pointer;
	list-style: none;
}

css houseSelectorMenuStyle() {
	display: grid;
	gap: 0.25rem;
	min-width: min(22rem, calc(100vw - 2rem));
	margin-top: 0.45rem;
	padding: 0.45rem;
	border: 1px solid var(--border);
	border-radius: 0.65rem;
	background: var(--surface);
	box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.28);
}

css houseSelectorItemStyle() {
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
	padding: 0.45rem 0.55rem;
	border: 0;
	border-radius: 0.45rem;
	background: transparent;
	color: var(--text);
	text-align: left;
	text-decoration: none;
	font-size: 0.85rem;
}

css houseSelectorActiveStyle() {
	color: var(--accent-hover);
}

css houseSelectorDividerStyle() {
	height: 1px;
	margin: 0.25rem 0;
	background: var(--border);
}

css userBadgeStyle() {
	position: fixed;
	top: 1rem;
	right: 1rem;
	display: inline-flex;
	align-items: center;
	gap: 0.35rem;
	max-width: calc(100vw - 2rem);
	padding: 0.4rem 0.55rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	background: var(--surface);
	color: var(--text);
	font-size: 0.85rem;
	text-decoration: none;
}

css userBadgeIconStyle() {
	flex: 0 0 auto;
}

css userBadgeTextStyle() {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

css screenHeaderStyle() {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 1rem;
	border-bottom: 1px solid var(--border);
	padding-bottom: 1rem;
	margin-bottom: 1rem;
}

css flushBlockStyle() {
	margin: 0;
}

templ WebPage(title string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<style>
				:root {
					color-scheme: dark;
					--bg: #282828;
					--surface: #32302f;
					--text: #ebdbb2;
					--muted: #a89984;
					--border: #504945;
					--accent: #83a598;
					--accent-hover: #8ec07c;
					--danger: #fb4934;
				}

				* {
					box-sizing: border-box;
				}

				html,
				body {
					margin: 0;
					padding: 0;
					background: var(--bg);
					color: var(--text);
					font-family: "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
				}

				body {
					min-height: 100dvh;
					display: grid;
					place-items: center;
					padding: 4rem 1.5rem 1.5rem;
				}

				main {
					width: min(100%, 36rem);
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: 0.75rem;
					padding: 1.5rem;
				}

				h1 {
					margin-top: 0;
					margin-bottom: 0.5rem;
				}

				p {
					color: var(--muted);
				}

				form {
					display: grid;
					gap: 0.75rem;
				}

				label {
					font-size: 0.95rem;
				}

				input,
				button {
					font: inherit;
					border-radius: 0.5rem;
				}

				input {
					width: 100%;
					padding: 0.625rem 0.75rem;
					border: 1px solid var(--border);
					background: #1d2021;
					color: var(--text);
				}

				input:focus,
				button:focus,
				a:focus {
					outline: 2px solid var(--accent);
					outline-offset: 2px;
				}

				button {
					padding: 0.625rem 0.875rem;
					border: 1px solid transparent;
					background: var(--accent);
					color: #282828;
					cursor: pointer;
				}

				button:hover {
					background: var(--accent-hover);
				}

				a {
					color: #fabd2f;
				}

				[role="alert"] {
					color: var(--danger);
					font-weight: 600;
				}

				main:has(.app-screen),
				main:has(.dev-screen),
				main:has(.me-screen) {
					width: min(100%, 88rem);
					min-height: calc(100dvh - 5.5rem);
				}

				@media (max-width: 42rem) {
					.screen-header,
					.device-card {
						display: grid;
						align-items: start;
					}
				}
			</style>
			<script type="module" src={ LocalDatastarScriptPath }></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ HouseSelector(houses []AppHouseData, activeHouseID string, then string) {
	if len(houses) > 0 {
		<details class={ houseSelectorStyle() } data-house-selector>
			<summary class={ houseSelectorSummaryStyle() }>
				<span class={ userBadgeTextStyle() }>{ activeHouseName(houses, activeHouseID) }</span>
				<span aria-hidden="true">▾</span>
			</summary>
			<div class={ houseSelectorMenuStyle() }>
				for _, house := range houses {
					if house.ID == activeHouseID {
						<div class={ houseSelectorItemStyle(), houseSelectorActiveStyle() } aria-current="true">
							<span>{ house.DisplayName }</span>
							<span aria-hidden="true">✓</span>
						</div>
					} else {
						<form method="post" action={ templ.SafeURL(activeHousePath()) }>
							<input type="hidden" name="house_id" value={ house.ID }/>
							<input type="hidden" name="then" value={ then }/>
							<button class={ houseSelectorItemStyle() } type="submit">{ house.DisplayName }</button>
						</form>
					}
				}
				<div class={ houseSelectorDividerStyle() }></div>
				<a class={ houseSelectorItemStyle() } href={ templ.SafeURL(houseManagePath(activeHouseID)) }>Manage house</a>
			</div>
		</details>
	}
}

templ UserBadge(displayName string) {
	if displayName != "" {
		<a class={ userBadgeStyle() } href="/me" aria-label={ displayName }>
			<svg class={ userBadgeIconStyle() } xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M7 21v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>
			<span class={ userBadgeTextStyle() }>{ displayName }</span>
		</a>
	}
}

templ ScreenHeader(title string, subtitle string) {
	<header class={ "screen-header", screenHeaderStyle() }>
		<h1 class={ flushBlockStyle() }>{ title }</h1>
		<p class={ flushBlockStyle() }>{ subtitle }</p>
	</header>
}

templ PageLayout(title string, displayName string) {
	@WebPage(title) {
		@UserBadge(displayName)
		<main>
			{ children... }
		</main>
	}
}
