package webui

css userBadgeStyle() {
	position: fixed;
	top: 1rem;
	right: 1rem;
	display: inline-flex;
	align-items: center;
	gap: 0.35rem;
	max-width: calc(100vw - 2rem);
	padding: 0.4rem 0.55rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	background: var(--surface);
	color: var(--text);
	font-size: 0.85rem;
	text-decoration: none;
}

css userBadgeIconStyle() {
	flex: 0 0 auto;
}

css userBadgeTextStyle() {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

css screenHeaderStyle() {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 1rem;
	border-bottom: 1px solid var(--border);
	padding-bottom: 1rem;
	margin-bottom: 1rem;
}

css flushBlockStyle() {
	margin: 0;
}

css cardGridStyle() {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
	gap: 1rem;
}

css plainListGridStyle() {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
	gap: 1rem;
	margin: 0;
	padding-left: 0;
	list-style: none;
}

css panelListItemStyle() {
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css compactLogoutFormStyle() {
	margin-top: 1rem;
	width: fit-content;
}

css appHouseCardStyle() {
	display: grid;
	gap: 0.75rem;
	align-content: start;
	margin-top: 0;
	padding: 1rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css houseRoleStyle() {
	color: var(--muted);
	font-size: 0.9rem;
}

css deviceEmptyStyle() {
	color: var(--muted);
	font-style: italic;
}

css deviceListStyle() {
	display: grid;
	gap: 0.5rem;
	margin: 0;
	padding-left: 0;
	list-style: none;
}

css deviceCardStyle() {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 0.75rem;
	padding: 0.65rem 0.75rem;
	border: 1px solid var(--border);
	border-radius: 0.5rem;
}

css deviceNameStyle() {
	min-width: 0;
	overflow-wrap: anywhere;
}

css deviceStateStyle() {
	flex: 0 0 auto;
	color: var(--muted);
}

templ WebPage(title string, htmxScriptSrc string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<style>
				:root {
					color-scheme: dark;
					--bg: #282828;
					--surface: #32302f;
					--text: #ebdbb2;
					--muted: #a89984;
					--border: #504945;
					--accent: #83a598;
					--accent-hover: #8ec07c;
					--danger: #fb4934;
				}

				* {
					box-sizing: border-box;
				}

				html,
				body {
					margin: 0;
					padding: 0;
					background: var(--bg);
					color: var(--text);
					font-family: "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
				}

				body {
					min-height: 100dvh;
					display: grid;
					place-items: center;
					padding: 1.5rem;
				}

				main {
					width: min(100%, 36rem);
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: 0.75rem;
					padding: 1.5rem;
				}

				h1 {
					margin-top: 0;
					margin-bottom: 0.5rem;
				}

				p {
					color: var(--muted);
				}

				form {
					display: grid;
					gap: 0.75rem;
				}

				label {
					font-size: 0.95rem;
				}

				input,
				button {
					font: inherit;
					border-radius: 0.5rem;
				}

				input {
					width: 100%;
					padding: 0.625rem 0.75rem;
					border: 1px solid var(--border);
					background: #1d2021;
					color: var(--text);
				}

				input:focus,
				button:focus,
				a:focus {
					outline: 2px solid var(--accent);
					outline-offset: 2px;
				}

				button {
					padding: 0.625rem 0.875rem;
					border: 1px solid transparent;
					background: var(--accent);
					color: #282828;
					cursor: pointer;
				}

				button:hover {
					background: var(--accent-hover);
				}

				a {
					color: #fabd2f;
				}

				[role="alert"] {
					color: var(--danger);
					font-weight: 600;
				}

				main:has(.app-screen),
				main:has(.dev-screen),
				main:has(.me-screen) {
					width: min(100%, 88rem);
					min-height: calc(100dvh - 3rem);
				}

				@media (max-width: 42rem) {
					.screen-header,
					.device-card {
						display: grid;
						align-items: start;
					}
				}
			</style>
			<script src={ scriptSrcOrDefault(htmxScriptSrc) } defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ UserBadge(displayName string) {
	if displayName != "" {
		<a class={ userBadgeStyle() } href="/me" aria-label={ displayName }>
			<svg class={ userBadgeIconStyle() } xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M7 21v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>
			<span class={ userBadgeTextStyle() }>{ displayName }</span>
		</a>
	}
}

templ PageLayout(title string, htmxScriptSrc string, displayName string) {
	@WebPage(title, htmxScriptSrc) {
		@UserBadge(displayName)
		<main>
			{ children... }
		</main>
	}
}

templ HomePage(data HomePageData) {
	@PageLayout("Hata", data.HTMXScriptSrc, data.DisplayName) {
		<div class="dev-screen">
			<header class={ "screen-header", screenHeaderStyle() }>
				<h1 class={ flushBlockStyle() }>Hata</h1>
				<p class={ flushBlockStyle() }>Smart home backend.</p>
			</header>
			<ul class={ plainListGridStyle() }>
				if !data.IsLoggedIn {
					<li class={ panelListItemStyle() }><a href="/auth/login">Sign in</a></li>
				}
				<li class={ panelListItemStyle() }><a href="/me">My session</a></li>
				<li class={ panelListItemStyle() }><a href="/app">App</a></li>
				<li class={ panelListItemStyle() }><a href="/health">Health check</a></li>
				<li class={ panelListItemStyle() }><a href="/apiui">API UI</a></li>
			</ul>
		</div>
	}
}

templ LoginPage(data LoginPageData) {
	@WebPage("Sign in · Hata", data.HTMXScriptSrc) {
		<main>
			<h1>Sign in</h1>
			<p>Use your credentials to start a browser session.</p>
			<div id="login-shell">
				<form id="login-form" method="post" action="/auth/login" hx-post="/auth/login" hx-target="#login-shell" hx-swap="outerHTML">
					<label for="username">Username</label>
					<input id="username" name="username" type="text" autocomplete="username" required/>

					<label for="password">Password</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required/>

					<input type="hidden" name="then" value={ data.Then }/>
					<button type="submit">Sign in</button>
				</form>
				if data.Error != "" {
					<p role="alert">{ data.Error }</p>
				}
			</div>
		</main>
	}
}

templ LogoutPage(data LogoutPageData) {
	@WebPage("Sign out · Hata", data.HTMXScriptSrc) {
		<main id="logout-shell">
			<h1>Sign out</h1>
			<p>This clears your auth cookie for this browser.</p>
			<form method="post" action="/auth/logout" hx-post="/auth/logout" hx-target="#logout-shell" hx-swap="outerHTML">
				<button type="submit">Sign out</button>
			</form>
		</main>
	}
}

templ MePage(data MePageData) {
	@PageLayout("Me · Hata", data.HTMXScriptSrc, data.DisplayName) {
		<div class="me-screen">
			<header class={ "screen-header", screenHeaderStyle() }>
				<h1 class={ flushBlockStyle() }>My session</h1>
				<p class={ flushBlockStyle() }>Authenticated page.</p>
			</header>
			<ul class={ plainListGridStyle() }>
				<li class={ panelListItemStyle() }>User ID: { data.UserID }</li>
				<li class={ panelListItemStyle() }>Username: { data.Username }</li>
				if data.HasSessionToken {
					<li class={ panelListItemStyle() }>Session token: present</li>
				} else {
					<li class={ panelListItemStyle() }>Session token: missing</li>
				}
			</ul>
			<form class={ compactLogoutFormStyle() } method="post" action="/auth/logout">
				<button type="submit">Sign out</button>
			</form>
		</div>
	}
}

templ AppPage(data AppPageData) {
	@PageLayout("App · Hata", data.HTMXScriptSrc, data.DisplayName) {
		<div class="app-screen">
			<header class={ "screen-header", screenHeaderStyle() }>
				<h1 class={ flushBlockStyle() }>My devices</h1>
				<p class={ flushBlockStyle() }>Devices grouped by houses.</p>
			</header>
			if len(data.Houses) == 0 {
				<p>You don't have access to any houses yet.</p>
			} else {
				<div class={ cardGridStyle() }>
					for _, house := range data.Houses {
						<section class={ appHouseCardStyle() }>
							<h2 class={ flushBlockStyle() }>{ house.DisplayName }</h2>
							<p class={ flushBlockStyle(), houseRoleStyle() }>House ID: { house.ID } · Role: { house.Role }</p>
							if len(house.Devices) == 0 {
								<p class={ flushBlockStyle(), deviceEmptyStyle() }>No devices in this house.</p>
							} else {
								<ul class={ deviceListStyle() }>
									for _, device := range house.Devices {
										<li class={ "device-card", deviceCardStyle() }><span class={ deviceNameStyle() }>{ device.Name } ({ device.ID })</span><span class={ deviceStateStyle() }>· { device.State }</span></li>
									}
								</ul>
							}
						</section>
					}
				</div>
			}
		</div>
	}
}
