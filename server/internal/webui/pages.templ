package webui

templ WebPage(title string, htmxScriptSrc string) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<style>
				:root {
					color-scheme: dark;
					--bg: #282828;
					--surface: #32302f;
					--text: #ebdbb2;
					--muted: #a89984;
					--border: #504945;
					--accent: #83a598;
					--accent-hover: #8ec07c;
					--danger: #fb4934;
				}

				* {
					box-sizing: border-box;
				}

				html,
				body {
					margin: 0;
					padding: 0;
					background: var(--bg);
					color: var(--text);
					font-family: "JetBrains Mono", "Fira Code", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
				}

				body {
					min-height: 100dvh;
					display: grid;
					place-items: center;
					padding: 1.5rem;
				}

				main {
					width: min(100%, 36rem);
					background: var(--surface);
					border: 1px solid var(--border);
					border-radius: 0.75rem;
					padding: 1.5rem;
				}

				h1 {
					margin-top: 0;
					margin-bottom: 0.5rem;
				}

				p {
					color: var(--muted);
				}

				form {
					display: grid;
					gap: 0.75rem;
				}

				label {
					font-size: 0.95rem;
				}

				input,
				button {
					font: inherit;
					border-radius: 0.5rem;
				}

				input {
					width: 100%;
					padding: 0.625rem 0.75rem;
					border: 1px solid var(--border);
					background: #1d2021;
					color: var(--text);
				}

				input:focus,
				button:focus,
				a:focus {
					outline: 2px solid var(--accent);
					outline-offset: 2px;
				}

				button {
					padding: 0.625rem 0.875rem;
					border: 1px solid transparent;
					background: var(--accent);
					color: #282828;
					cursor: pointer;
				}

				button:hover {
					background: var(--accent-hover);
				}

				a {
					color: #fabd2f;
				}

				.user-link {
					display: inline-flex;
					align-items: center;
					gap: 0.35rem;
				}

				.user-link svg {
					display: block;
				}

				[role="alert"] {
					color: var(--danger);
					font-weight: 600;
				}
			</style>
			<script src={ scriptSrcOrDefault(htmxScriptSrc) } defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ HomePage(data HomePageData) {
	@WebPage("Hata", data.HTMXScriptSrc) {
		<main>
			<h1>Hata</h1>
			<p>Smart home backend.</p>
			<ul>
				if data.IsLoggedIn {
					<li>
						<a class="user-link" href="/me">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-user-icon lucide-square-user"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M7 21v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2"/></svg>
							<span>{ data.DisplayName }</span>
						</a>
					</li>
				} else {
					<li><a href="/auth/login">Sign in</a></li>
				}
				<li><a href="/me">My session</a></li>
				<li><a href="/health">Health check</a></li>
				<li><a href="/apiui">API UI</a></li>
			</ul>
		</main>
	}
}

templ LoginPage(data LoginPageData) {
	@WebPage("Sign in · Hata", data.HTMXScriptSrc) {
		<main>
			<h1>Sign in</h1>
			<p>Use your credentials to start a browser session.</p>
			<div id="login-shell">
				<form id="login-form" method="post" action="/auth/login" hx-post="/auth/login" hx-target="#login-shell" hx-swap="outerHTML">
					<label for="username">Username</label>
					<input id="username" name="username" type="text" autocomplete="username" required/>

					<label for="password">Password</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required/>

					<input type="hidden" name="then" value={ data.Then }/>
					<button type="submit">Sign in</button>
				</form>
				if data.Error != "" {
					<p role="alert">{ data.Error }</p>
				}
			</div>
		</main>
	}
}

templ LogoutPage(data LogoutPageData) {
	@WebPage("Sign out · Hata", data.HTMXScriptSrc) {
		<main id="logout-shell">
			<h1>Sign out</h1>
			<p>This clears your auth cookie for this browser.</p>
			<form method="post" action="/auth/logout" hx-post="/auth/logout" hx-target="#logout-shell" hx-swap="outerHTML">
				<button type="submit">Sign out</button>
			</form>
		</main>
	}
}

templ MePage(data MePageData) {
	@WebPage("Me · Hata", data.HTMXScriptSrc) {
		<main>
			<h1>My session</h1>
			<p>Authenticated page.</p>
			<ul>
				<li>User ID: { data.UserID }</li>
				<li>Username: { data.Username }</li>
				if data.HasSessionToken {
					<li>Session token: present</li>
				} else {
					<li>Session token: missing</li>
				}
			</ul>
			<form method="post" action="/auth/logout">
				<button type="submit">Sign out</button>
			</form>
		</main>
	}
}
