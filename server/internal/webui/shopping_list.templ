package webui

css shoppingListScreenStyle() {
	display: grid;
	gap: 1rem;
}

css shoppingListMetaStyle() {
	color: var(--muted);
	margin: 0;
}

css shoppingListAddFormStyle() {
	display: flex;
	gap: 0.5rem;
	align-items: center;
}


css shoppingListItemsStyle() {
	display: grid;
	gap: 0.5rem;
	padding: 0;
	margin: 0;
	list-style: none;
}

css shoppingListItemStyle() {
	display: flex;
	gap: 0.75rem;
	align-items: center;
	padding: 0.85rem 1rem;
	border: 1px solid var(--border);
	border-radius: 0.75rem;
	background: #282828;
}

css shoppingListItemNameStyle() {
	flex: 1 1 auto;
	min-width: 0;
}

css shoppingListItemCheckedStyle() {
	opacity: 0.65;
	text-decoration: line-through;
}

css shoppingListCheckButtonStyle() {
	width: 1.9rem;
	height: 1.9rem;
	padding: 0;
	display: inline-grid;
	place-items: center;
	border: 1px solid var(--border);
	border-radius: 0.35rem;
	background: #1d2021;
	color: var(--text);
	flex: 0 0 auto;
}

css shoppingListActionsStyle() {
	display: flex;
	gap: 0.4rem;
	align-items: center;
	flex: 0 0 auto;
}

css shoppingListIconFormStyle() {
	display: inline;
}

css shoppingListIconButtonStyle() {
	width: 2rem;
	height: 2rem;
	padding: 0;
	display: inline-grid;
	place-items: center;
	background: transparent;
	border-color: var(--border);
	color: var(--text);
}

css shoppingListDangerButtonStyle() {
	color: var(--danger);
}

templ ShoppingListPage(data ShoppingListPageData) {
	@WebPage(data.List.Name + " · Hata") {
		@HouseSelector(data.HeaderHouses, data.ActiveHouseID, data.PageURL)
		@UserBadge(data.DisplayName)
		<main>
			<div class={ "sl-screen", shoppingListScreenStyle() }>
				@ScreenHeader(data.List.Name, "Shopping list")
				if data.CanManageHouse {
					<p class={ shoppingListMetaStyle() }>{ data.House.DisplayName } · changes are saved automatically</p>
				} else {
					<p class={ shoppingListMetaStyle() }>{ data.House.DisplayName } · read-only</p>
				}
				<div class={ deviceActionsRowStyle() }>
					<a href="/app">Back to app</a>
				</div>
				if data.CanManageHouse {
					<form class={ shoppingListAddFormStyle() } method="post" action={ templ.SafeURL(shoppingListItemsPath(data.List.ID)) }>
						<input type="text" name="name" placeholder="Add an item" aria-label="New shopping item" autocomplete="off" required/>
						<button class={ "sl-add-button", deviceIconToggleButtonStyle() } type="submit" aria-label="Add item" title="Add">
							@addShoppingItemIcon()
						</button>
					</form>
				}
				if len(data.Items) == 0 {
					<p class={ appFlushBlockStyle(), deviceEmptyStyle() }>No items in this shopping list.</p>
				} else {
					<ul class={ shoppingListItemsStyle() }>
						for _, item := range data.Items {
							<li class={ shoppingListItemStyle() }>
								if data.CanManageHouse {
									<form class={ shoppingListIconFormStyle() } method="post" action={ templ.SafeURL(shoppingListItemCheckPath(data.List.ID, item.ID)) }>
										if item.Checked {
											<input type="hidden" name="checked" value="false"/>
											<button class={ shoppingListCheckButtonStyle() } type="submit" aria-label="Mark item not done">✓</button>
										} else {
											<input type="hidden" name="checked" value="true"/>
											<button class={ shoppingListCheckButtonStyle() } type="submit" aria-label="Mark item done"></button>
										}
									</form>
								} else {
									<span class={ shoppingListCheckButtonStyle() } aria-hidden="true">
										if item.Checked {
											<span>✓</span>
										}
									</span>
								}
								if item.Checked {
									<span class={ shoppingListItemNameStyle(), shoppingListItemCheckedStyle() }>{ item.Name }</span>
								} else {
									<span class={ shoppingListItemNameStyle() }>{ item.Name }</span>
								}
								if data.CanManageHouse {
									<div class={ shoppingListActionsStyle() }>
										<form class={ "sl-rename-form", shoppingListIconFormStyle() } method="post" action={ templ.SafeURL(shoppingListItemRenamePath(data.List.ID, item.ID)) } data-current-name={ item.Name }>
											<input type="hidden" name="name" value={ item.Name }/>
											<button class={ shoppingListIconButtonStyle() } type="submit" aria-label="Rename item">
												<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M227.31,73.37,182.63,28.68a16,16,0,0,0-22.63,0L36.69,152A15.86,15.86,0,0,0,32,163.31V208a16,16,0,0,0,16,16H92.69A15.86,15.86,0,0,0,104,219.31L227.31,96a16,16,0,0,0,0-22.63ZM92.69,208H48V163.31l88-88L180.69,120ZM192,108.68,147.31,64l24-24L216,84.68Z"></path></svg>
											</button>
										</form>
										<form class={ "sl-delete-form", shoppingListIconFormStyle() } method="post" action={ templ.SafeURL(shoppingListItemDeletePath(data.List.ID, item.ID)) } data-current-name={ item.Name }>
											<button class={ shoppingListIconButtonStyle(), shoppingListDangerButtonStyle() } type="submit" aria-label="Remove item">
												<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96Zm96,168H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z"></path></svg>
											</button>
										</form>
									</div>
								}
							</li>
						}
					</ul>
				}
			</div>
		</main>
		<script>
			document.querySelectorAll('.sl-rename-form').forEach((form) => {
				form.addEventListener('submit', (event) => {
					const currentName = form.dataset.currentName || '';
					const nextName = prompt('New item name:', currentName);
					if (nextName === null) {
						event.preventDefault();
						return;
					}
					const trimmed = nextName.trim();
					if (!trimmed || trimmed === currentName) {
						event.preventDefault();
						return;
					}
					form.querySelector('input[name="name"]').value = trimmed;
				});
			});
			document.querySelectorAll('.sl-delete-form').forEach((form) => {
				form.addEventListener('submit', (event) => {
					const currentName = form.dataset.currentName || 'this item';
					if (!confirm(`Remove ${currentName}?`)) {
						event.preventDefault();
					}
				});
			});
		</script>
	}
}
