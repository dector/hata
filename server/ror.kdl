task build {
    description "Build project"

    cmd "VERSION=\"$(./scripts/git_version.sh)\"; go build -ldflags \"-X hata/version.Version=${VERSION}\" -o out/hata ./cmd/hata/"
}

task dev:server {
    description "Run project (live reload with Tailscale Serve, no proxy)"

    cmd #"""
      go tool gust \
        -e 'HATA_DEV=1 go run -ldflags "-X hata/version.Version=$(./scripts/git_version.sh)" ./cmd/hata' \
        -T \
        --e.before 'go tool templ generate ./internal/webui' \
        --exclude data \
        --exclude docs \
        --exclude out \
        --exclude .jj \
        --exclude.glob '*_templ.go'
    """#
}

task dev {
    description "Run project (live reload with Tailscale Serve)"

    cmd "bash ./scripts/dev_with_local_proxy.sh"
}

//region LLM-context

task ai:build {
    description "[Agent] build project"

    cmd "VERSION=\"$(./scripts/git_version.sh)\"; go build -ldflags \"-X hata/version.Version=${VERSION}\" -o out/hata.llm ./cmd/hata/"
}

//endregion
